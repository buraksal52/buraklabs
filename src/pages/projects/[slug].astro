---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import DemoHost from '../../components/demos/DemoHost.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => data.locale === 'en' && !data.draft);
  return projects.map((project) => ({ params: { slug: project.data.slug }, props: { project } }));
}
const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout locale="en" path={`/projects/${project.data.slug}`} alternatePath={`/tr/projects/${project.data.slug}`} personSchema projectSchema={{ name: project.data.title, description: project.data.seo.description, categories: project.data.categories, technologies: project.data.technologies, status: project.data.status, createdAt: project.data.createdAt, updatedAt: project.data.updatedAt }} title={`${project.data.seo.title} — BurakLabs`} description={project.data.seo.description}>
  <main id="main-content" class="case-study" data-pagefind-body>
    <article>
      <a class="back" href="/projects">← Projects</a>
      <p class="eyebrow">{project.data.maturity} / {project.data.status}</p>
      <h1>{project.data.title}</h1>
      <p class="lede">{project.data.summary}</p>
      {project.data.demoId && <DemoHost demoId={project.data.demoId} locale="en" />}
      <Content />
    </article>
    <aside><h2>Project notes</h2><div class="tags">{project.data.categories.map((tag) => <span class="tag">{tag}</span>)}</div><p><strong>Evidence state:</strong> {project.data.maturity}</p>{project.data.myRole && <p><strong>Role:</strong> {project.data.myRole}</p>}</aside>
  </main>
</BaseLayout>
