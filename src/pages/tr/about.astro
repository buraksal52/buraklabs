---
import BaseLayout from '../../layouts/BaseLayout.astro';
import siteContent from '../../data/site-content.json';

const { profile, links, about } = siteContent;
const content = about.tr;
---
<BaseLayout locale="tr" path="/tr/about" alternatePath="/about" personSchema profilePageSchema breadcrumbs={[{ name: 'Ana sayfa', url: '/tr/' }, { name: 'Ömer Burak Şal hakkında', url: '/tr/about' }]} title="Ömer Burak Şal — Hakkında | BurakLabs" description="Yazılım mühendisliği, yapay zekâ, sistemler, HCI ve ürün mühendisliği alanlarında çalışan Ömer Burak Şal hakkında.">
  <main id="main-content" data-pagefind-body>
    <p class="eyebrow">BurakLabs / Hakkında</p>
    <h1>Bağımsız bir stüdyo kaydı.</h1>
    <div class="content-empty"><h2>{profile.fullName}</h2><p>{content.whoIAm}</p><p>{content.whoIAmDetail}</p><h3>Ne yapıyorum</h3><p>{content.whatIDo}</p><p>{content.whatIDoDetail}</p><h3>Bu nereye gidiyor</h3><p>{content.whereThisLeads}</p><div class="content-links"><a class="button-link" href="/tr/projects">Projeleri görüntüle</a><a href={links.github} rel="me noopener noreferrer">GitHub</a><a href={links.linkedin} rel="me noopener noreferrer">LinkedIn</a><a class="back" href="/tr/contact">İletişim →</a></div></div>
  </main>
</BaseLayout>
