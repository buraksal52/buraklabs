---
import '../styles/global.css';

interface Props {
  title: string;
  description: string;
  locale: 'en' | 'tr';
  path?: string;
  alternatePath?: string;
  noindex?: boolean;
}
const { title, description, locale, path, alternatePath, noindex = false } = Astro.props;
const prefix = locale === 'tr' ? '/tr' : '';
const canonicalPath = path ?? Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://buraklabs.studio');
const alternateUrl = alternatePath ? new URL(alternatePath, Astro.site ?? 'https://buraklabs.studio') : undefined;
const otherLocale = locale === 'tr' ? 'en' : 'tr';
const languageHref = alternatePath ?? (locale === 'tr' ? '/' : '/tr');
const isHome = canonicalPath === '/' || canonicalPath === '/tr/';
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
    {alternateUrl && <link rel="alternate" hreflang={otherLocale} href={alternateUrl} />}
    {alternateUrl && isHome && <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonicalUrl : alternateUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    <script is:inline>
      const systemTheme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
      try {
        const savedTheme = localStorage.getItem('buraklabs-theme');
        document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : systemTheme;
      } catch {
        document.documentElement.dataset.theme = systemTheme;
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <header class="site-header" data-pagefind-ignore>
        <a class="brand" href={prefix || '/'}>BurakLabs</a>
        <nav aria-label={locale === 'tr' ? 'Ana navigasyon' : 'Main navigation'}>
          <a href={`${prefix}/projects`}>{locale === 'tr' ? 'Projeler' : 'Projects'}</a>
          <a href={`${prefix}/research`}>{locale === 'tr' ? 'Araştırma' : 'Research'}</a>
          <a href={`${prefix}/writing`}>{locale === 'tr' ? 'Yazılar' : 'Writing'}</a>
          <a href={`${prefix}/about`}>{locale === 'tr' ? 'Hakkında' : 'About'}</a>
          <a href={`${prefix}/cv`}>CV</a>
          <a href={`${prefix}/contact`}>{locale === 'tr' ? 'İletişim' : 'Contact'}</a>
          <a href={`${prefix}/search`}>{locale === 'tr' ? 'Ara' : 'Search'}</a>
          <a href={languageHref}>{locale === 'tr' ? 'English' : 'Türkçe'}</a>
          <button type="button" data-theme-toggle aria-label={locale === 'tr' ? 'Temayı değiştir' : 'Change theme'}>◐</button>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  themeToggle?.addEventListener('click', () => {
    const nextTheme = document.documentElement.dataset.theme === 'dark' ? 'light' : 'dark';
    document.documentElement.dataset.theme = nextTheme;
    try { localStorage.setItem('buraklabs-theme', nextTheme); } catch { /* system preference remains active */ }
  });

  const revealItems = [...document.querySelectorAll<HTMLElement>('[data-scroll-reveal]')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (revealItems.length && !reducedMotion && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('scroll-motion-ready');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }

  const aboutSteps = [...document.querySelectorAll<HTMLElement>('[data-about-step]')];
  const aboutStages = [...document.querySelectorAll<HTMLElement>('[data-about-stage]')];
  if (aboutSteps.length && aboutStages.length && 'IntersectionObserver' in window) {
    const aboutObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const step = entry.target.getAttribute('data-about-step');
          aboutStages.forEach((stage) => stage.classList.toggle('is-active', stage.getAttribute('data-about-stage') === step));
        }
      });
    }, { threshold: 0.2, rootMargin: '-10% 0px -10% 0px' });
    aboutSteps.forEach((step) => aboutObserver.observe(step));
  }
</script>
