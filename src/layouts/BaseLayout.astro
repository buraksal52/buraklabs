---
import '../styles/global.css';
import siteContent from '../data/site-content.json';

interface Props {
  title: string;
  description: string;
  locale: 'en' | 'tr';
  path?: string;
  alternatePath?: string;
  noindex?: boolean;
  personSchema?: boolean;
  websiteSchema?: boolean;
  profilePageSchema?: boolean;
  projectSchema?: {
    name: string;
    description: string;
    categories: string[];
    technologies: string[];
    status: string;
    createdAt?: string;
    updatedAt?: string;
  };
  researchSchema?: Array<{
    id: string;
    name: string;
    description: string;
    areas: string[];
    status: string;
    authors: string[];
  }>;
}
const { title, description, locale, path, alternatePath, noindex = false, personSchema = false, websiteSchema = false, profilePageSchema = false, projectSchema, researchSchema = [] } = Astro.props;
const { profile, links, about } = siteContent;
const prefix = locale === 'tr' ? '/tr' : '';
const canonicalPath = path ?? Astro.url.pathname;
const canonicalUrl = new URL(canonicalPath, Astro.site ?? 'https://buraklabs.studio');
const alternateUrl = alternatePath ? new URL(alternatePath, Astro.site ?? 'https://buraklabs.studio') : undefined;
const otherLocale = locale === 'tr' ? 'en' : 'tr';
const languageHref = alternatePath ?? (locale === 'tr' ? '/' : '/tr');
const isHome = canonicalPath === '/' || canonicalPath === '/tr/';
const personStructuredData = personSchema ? {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': 'https://buraklabs.studio/#person',
  name: profile.fullName,
  url: 'https://buraklabs.studio/about',
  image: new URL(profile.portrait, Astro.site ?? 'https://buraklabs.studio').toString(),
  jobTitle: locale === 'tr' ? profile.headlineTr : profile.headlineEn,
  description: locale === 'tr' ? about.tr.whoIAm : about.en.whoIAm,
  sameAs: [links.github, links.linkedin],
  knowsAbout: ['Software engineering', 'Artificial intelligence', 'Computer systems', 'Human-computer interaction', 'Product engineering']
} : undefined;
const projectStructuredData = projectSchema ? {
  '@type': 'CreativeWork',
  '@id': `${canonicalUrl.toString()}#project`,
  url: canonicalUrl.toString(),
  name: projectSchema.name,
  description: projectSchema.description,
  inLanguage: locale,
  author: { '@id': 'https://buraklabs.studio/#person' },
  keywords: [...projectSchema.categories, ...projectSchema.technologies],
  creativeWorkStatus: projectSchema.status,
  ...(projectSchema.createdAt ? { dateCreated: projectSchema.createdAt } : {}),
  ...(projectSchema.updatedAt ? { dateModified: projectSchema.updatedAt } : {})
} : undefined;
const researchStructuredData = researchSchema.map((research) => ({
  '@type': 'ResearchProject',
  '@id': `${canonicalUrl.toString()}#research-${research.id}`,
  url: canonicalUrl.toString(),
  name: research.name,
  description: research.description,
  inLanguage: locale,
  author: research.authors,
  keywords: research.areas,
  additionalProperty: {
    '@type': 'PropertyValue',
    name: 'Research status',
    value: research.status
  }
}));
const structuredData = personStructuredData || projectStructuredData || researchStructuredData.length ? {
  '@context': 'https://schema.org',
  '@graph': [
    ...(personStructuredData ? [personStructuredData] : []),
    ...(websiteSchema ? [{
      '@type': 'WebSite',
      '@id': 'https://buraklabs.studio/#website',
      url: 'https://buraklabs.studio/',
      name: 'BurakLabs',
      description,
      publisher: { '@id': 'https://buraklabs.studio/#person' },
      inLanguage: locale
    }] : []),
    ...(profilePageSchema ? [{
      '@type': 'ProfilePage',
      '@id': `${canonicalUrl.toString()}#profile`,
      url: canonicalUrl.toString(),
      name: title,
      inLanguage: locale,
      mainEntity: { '@id': 'https://buraklabs.studio/#person' }
    }] : []),
    ...(projectStructuredData ? [projectStructuredData] : []),
    ...researchStructuredData
  ]
} : undefined;
---
<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:image" content="https://buraklabs.studio/brand/icons/og-image.png" />
    <meta property="og:image:alt" content="BurakLabs — Research / Engineering / Experiments" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://buraklabs.studio/brand/icons/og-image.png" />
    <link rel="icon" type="image/svg+xml" href="/brand/svg/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/brand/icons/favicon.ico" sizes="any" />
    <link rel="apple-touch-icon" href="/brand/icons/apple-touch-icon.png" />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang={locale} href={canonicalUrl} />
    {alternateUrl && <link rel="alternate" hreflang={otherLocale} href={alternateUrl} />}
    {alternateUrl && isHome && <link rel="alternate" hreflang="x-default" href={locale === 'en' ? canonicalUrl : alternateUrl} />}
    {noindex && <meta name="robots" content="noindex, nofollow" />}
    {structuredData && <script type="application/ld+json" set:html={JSON.stringify(structuredData)} />}
    <script is:inline>
      try {
        const savedTheme = localStorage.getItem('buraklabs-theme');
        document.documentElement.dataset.theme = savedTheme === 'dark' || savedTheme === 'light' ? savedTheme : 'light';
      } catch {
        document.documentElement.dataset.theme = 'light';
      }
    </script>
    <title>{title}</title>
  </head>
  <body>
    <div class="shell">
      <a class="skip-link" href="#main-content">{locale === 'tr' ? 'Ana içeriğe geç' : 'Skip to main content'}</a>
      <header class="site-header" data-pagefind-ignore>
        <a class="brand" href={prefix || '/'} aria-label="BurakLabs home">
          <img class="brand-logo brand-logo-light-theme" src="/brand/svg/logo.svg" width="180" height="45" alt="BurakLabs" />
          <img class="brand-logo brand-logo-dark-theme" src="/brand/svg/logo-light.svg" width="180" height="45" alt="BurakLabs" />
        </a>
        <nav aria-label={locale === 'tr' ? 'Ana navigasyon' : 'Main navigation'}>
          <a href={`${prefix}/projects`}>{locale === 'tr' ? 'Projeler' : 'Projects'}</a>
          <a href={`${prefix}/research`}>{locale === 'tr' ? 'Araştırma' : 'Research'}</a>
          <a href={`${prefix}/writing`}>{locale === 'tr' ? 'Yazılar' : 'Writing'}</a>
          <a href={`${prefix}/about`}>{locale === 'tr' ? 'Hakkında' : 'About'}</a>
          <a href={`${prefix}/cv`}>CV</a>
          <a href={`${prefix}/contact`}>{locale === 'tr' ? 'İletişim' : 'Contact'}</a>
          <a href={`${prefix}/search`}>{locale === 'tr' ? 'Ara' : 'Search'}</a>
          <a href={languageHref}>{locale === 'tr' ? 'English' : 'Türkçe'}</a>
          <button type="button" data-theme-toggle aria-label={locale === 'tr' ? 'Temayı değiştir' : 'Change theme'} aria-pressed="false">◐</button>
        </nav>
      </header>
      <slot />
    </div>
  </body>
</html>
<script>
  const syncThemeToggle = () => {
    const theme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    const toggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
    if (!toggle) return;
    toggle.setAttribute('aria-pressed', String(theme === 'dark'));
    const isTurkish = document.documentElement.lang === 'tr';
    toggle.setAttribute('aria-label', isTurkish
      ? `${theme === 'dark' ? 'Karanlık' : 'Aydınlık'} tema. Temayı değiştir`
      : `${theme === 'dark' ? 'Dark' : 'Light'} theme. Toggle theme`);
  };
  const setTheme = (theme: 'light' | 'dark') => {
    document.documentElement.dataset.theme = theme;
    try { localStorage.setItem('buraklabs-theme', theme); } catch { /* persistence is optional */ }
    syncThemeToggle();
  };
  syncThemeToggle();
  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const themeToggle = target?.closest<HTMLButtonElement>('[data-theme-toggle]');
    if (!themeToggle) return;
    const currentTheme = document.documentElement.dataset.theme === 'dark' ? 'dark' : 'light';
    setTheme(currentTheme === 'dark' ? 'light' : 'dark');
  });

  const revealItems = [...document.querySelectorAll<HTMLElement>('[data-scroll-reveal]')];
  const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (revealItems.length && !reducedMotion && 'IntersectionObserver' in window) {
    document.documentElement.classList.add('scroll-motion-ready');
    const revealObserver = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      });
    }, { threshold: 0.16, rootMargin: '0px 0px -8% 0px' });
    revealItems.forEach((item) => revealObserver.observe(item));
  } else {
    revealItems.forEach((item) => item.classList.add('is-visible'));
  }

  const aboutSteps = [...document.querySelectorAll<HTMLElement>('[data-about-step]')];
  const aboutStages = [...document.querySelectorAll<HTMLElement>('[data-about-stage]')];
  if (aboutSteps.length && aboutStages.length && 'IntersectionObserver' in window) {
    const aboutObserver = new IntersectionObserver((entries) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          const step = entry.target.getAttribute('data-about-step');
          aboutStages.forEach((stage) => stage.classList.toggle('is-active', stage.getAttribute('data-about-stage') === step));
        }
      });
    }, { threshold: 0.2, rootMargin: '-10% 0px -10% 0px' });
    aboutSteps.forEach((step) => aboutObserver.observe(step));

    const reducedMotionForStepLock = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const story = document.querySelector<HTMLElement>('.about-sticky-story');
    let isStepAnimating = false;
    let wheelAccumulator = 0;
    let touchStartY: number | undefined;
    let touchTracking = false;
    let touchEnteringFirstStep = false;

    const getStoryMetrics = () => {
      if (!story) return undefined;
      const rect = story.getBoundingClientRect();
      return { top: rect.top + window.scrollY, bottom: rect.bottom + window.scrollY };
    };
    const isInStepLockZone = () => {
      const metrics = getStoryMetrics();
      if (!metrics) return false;
      const viewport = window.innerHeight;
      return window.scrollY >= metrics.top - viewport * 0.35 && window.scrollY <= metrics.bottom - viewport * 0.65;
    };
    const getCurrentStepIndex = () => {
      const marker = window.scrollY + window.innerHeight * 0.35;
      let currentIndex = 0;
      aboutSteps.forEach((step, index) => {
        const stepTop = step.getBoundingClientRect().top + window.scrollY;
        if (stepTop <= marker) currentIndex = index;
      });
      return currentIndex;
    };
    const getStepTarget = (index: number) => Math.max(0, aboutSteps[index].getBoundingClientRect().top + window.scrollY - 24);
    const isAlignedToStep = (index: number) => Math.abs(getStepTarget(index) - window.scrollY) < 72;
    const isEnteringFirstStep = (direction: 1 | -1) => direction === 1 && getCurrentStepIndex() === 0 && window.scrollY < getStepTarget(0) - 8;
    const moveAboutStep = (direction: 1 | -1) => {
      if (reducedMotionForStepLock || isStepAnimating || !isInStepLockZone()) return false;
      const currentIndex = getCurrentStepIndex();
      const aligned = isAlignedToStep(currentIndex);
      const nextIndex = aligned ? currentIndex + direction : currentIndex;
      if (nextIndex < 0 || nextIndex >= aboutSteps.length) return false;

      isStepAnimating = true;
      window.scrollTo({ top: getStepTarget(nextIndex), behavior: 'smooth' });
      window.setTimeout(() => { isStepAnimating = false; }, 620);
      return true;
    };

    window.addEventListener('wheel', (event) => {
      if (reducedMotionForStepLock || !isInStepLockZone()) return;
      const direction: 1 | -1 = event.deltaY > 0 ? 1 : -1;
      if (direction === -1) {
        wheelAccumulator = 0;
        return;
      }
      const currentIndex = getCurrentStepIndex();
      const atExitBoundary = currentIndex === aboutSteps.length - 1;
      if (atExitBoundary) return;
      if (isEnteringFirstStep(direction) && window.scrollY + Math.abs(event.deltaY) < getStepTarget(0) - 8) return;

      event.preventDefault();
      if (isStepAnimating) return;
      wheelAccumulator += event.deltaY;
      if (Math.abs(wheelAccumulator) < 32) return;
      const accumulatedDirection: 1 | -1 = wheelAccumulator > 0 ? 1 : -1;
      wheelAccumulator = 0;
      moveAboutStep(accumulatedDirection);
    }, { passive: false });

    window.addEventListener('touchstart', (event) => {
      touchStartY = event.touches[0]?.clientY;
      touchTracking = !reducedMotionForStepLock && isInStepLockZone();
      touchEnteringFirstStep = touchTracking && isEnteringFirstStep(1);
    }, { passive: true });
    window.addEventListener('touchmove', (event) => {
      if (!touchTracking || isStepAnimating || touchStartY === undefined) return;
      const distance = touchStartY - (event.touches[0]?.clientY ?? touchStartY);
      if (distance <= 0) return;
      const currentIndex = getCurrentStepIndex();
      const atExitBoundary = currentIndex === aboutSteps.length - 1;
      if (isEnteringFirstStep(1)) return;
      if (!atExitBoundary) event.preventDefault();
    }, { passive: false });
    window.addEventListener('touchend', (event) => {
      if (!touchTracking || touchStartY === undefined) return;
      const touchEndY = event.changedTouches[0]?.clientY ?? touchStartY;
      const distance = touchStartY - touchEndY;
      touchStartY = undefined;
      touchTracking = false;
      if (touchEnteringFirstStep) {
        touchEnteringFirstStep = false;
        return;
      }
      if (distance >= 28) moveAboutStep(1);
    }, { passive: true });

    window.addEventListener('keydown', (event) => {
      if (reducedMotionForStepLock || !isInStepLockZone()) return;
      const direction = event.key === 'ArrowDown' || event.key === 'PageDown' ? 1 : event.key === 'ArrowUp' || event.key === 'PageUp' ? -1 : 0;
      if (direction !== 1) return;
      if (isEnteringFirstStep(1)) return;
      const currentIndex = getCurrentStepIndex();
      const atExitBoundary = currentIndex === aboutSteps.length - 1;
      if (atExitBoundary) return;
      event.preventDefault();
      moveAboutStep(1);
    });
  }
</script>
